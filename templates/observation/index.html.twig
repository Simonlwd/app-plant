{% extends 'base.html.twig' %}

{% block body %}

    <h1>Observaties</h1>

    <a href="{{ path('app_observation_new') }}">+ Nieuwe observatie</a>

    <hr>
    <form method="get">
        <input
        type="text"
        name="search"
        value="{{ app.request.query.get('search') }}"
        placeholder="Zoek observaties..."
        >

        
            <input
            type="checkbox"
            name="hasImage"
            value="1"
            {% if app.request.query.get('hasImage') %}
                checked
            {% endif %}
            >
            Alleen met afbeelding<br>

            <input
            type="date"
            name="fromDate"
            value="{{ app.request.query.get('fromDate') }}"
            max="{{ "now"|date('Y-m-d') }}"
            >
            tot
            <input
            type="date"
            name="toDate"
            value="{{ app.request.query.get('toDate')}}"
            max="{{ "now"|date('Y-m-d') }}"
            >

            <button type="submit">Zoeken</button>
        </form>

        {% if activeFilters is not empty %}

            <div class="mb-4">

                <strong>Actieve filters:</strong>

                <div class="tags mt-2">

                    {% for filter in activeFilters %}
                        <span class="tag is-info is-medium">
                            {{ filter }}
                        </span>
                    {% endfor %}

                </div>

            </div>

        {% endif %}

        {% if hasFilters %}
            <a href="{{ path('app_observation_index') }}" class="button is-light is-small">
                Reset filters
            </a>
        {% endif %}
        <hr>

        {% for observation in pagination %}

            <div class="card">

                {% if observation.imagePath %}
                    <img src="{{ observation.imagePath }}" alt="Observation image" class="obs-image">
                {% endif %}

                <div class="obs-content">
                    <p class="obs-notes">
                        {{ observation.notes|default('Geen notities') }}
                    </p>

                    {% if observation.locationName %}
                        <p class="obs-location">📍
                        {{ observation.locationName }}</p>
                    {% endif %}

                    <small class="obs-date">
                        {{ observation.createdAt|date('d-m-Y H:i') }}
                    </small>
                    <a href="{{ path('app_observation_edit', {id: observation.id}) }}">Bewerken</a>
                    <form method="post" action="{{ path('app_observation_delete', {id: observation.id}) }}" onsubmit="return confirm('Weet je zeker dat je deze observatie wilt verwijderen?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ observation.id) }}">
                        <button class="btn btn-danger">Verwijderen</button>
                    </form>
                </div>

            </div>


        {% else %}
            {% if hasFilters %}
                <div class="notification is-warning is-light">
                    <p>Geen observaties gevonden met huidige filters.</p>
                </div>
            {% else %}
                <div class="notification is-info is-light">
                    <p>Geen observaties gevonden.</p>
                </div>
            {% endif %}
        {% endfor %}
        {{ knp_pagination_render(pagination) }}

    {% endblock %}
