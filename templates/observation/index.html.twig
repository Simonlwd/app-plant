{% extends 'base.html.twig' %}

{% block body %}

	<h1>Observaties</h1>

	<a href="{{ path('app_observation_new') }}">+ Nieuwe observatie</a>

	<hr>

	{% for observation in pagination %}

		<div style="border:1px solid #ccc; padding:10px; margin-bottom:10px;">

			{% if observation.imagePath %}
				<img src="{{ observation.imagePath }}" style="max-width:200px;">
			{% endif %}

			<p>
				<strong>Notes:</strong>
				{{ observation.notes }}</p>

			<p>
				<strong>Locatie:</strong>
				{{ observation.locationName }}</p>

			<small>{{ observation.createdAt|date('d-m-Y H:i') }}</small>

		</div>

		{{ knp_pagination_render(pagination) }}

	{% else %}
		<p>Geen observaties gevonden.</p>
	{% endfor %}

{% endblock %}
