<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}MyApp{% endblock %}</title>

    {# ----- Bootstrap Play CDN ----- #}
    {% if bootstrap %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    {% endif %}

    {# ----- Tailwind Play CDN ----- #}
    {% if tailwind %}
        <script src="https://cdn.tailwindcss.com"></script>
    {% endif %}

    {# Eigen CSS (optioneel) #}
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
</head>
<body class="{% if tailwind %}bg-gray-100{% endif %}">

    {# ----- Navbar ----- #}
    {% if bootstrap %}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <a class="navbar-brand" href="{{ path('app_home') }}">MyApp</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="{{ path('app_observation_index') }}">Observations</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_plant_index') }}">Plants</a></li>
            </ul>
        </div>
    </nav>
    {% endif %}

    {% if tailwind %}
    <nav class="bg-gray-800 text-white p-4 flex justify-between items-center">
        <a href="{{ path('app_home') }}" class="font-bold">MyApp</a>
        <div class="space-x-4 hidden md:flex">
            <a href="{{ path('app_observation_index') }}" class="hover:underline">Observations</a>
            <a href="{{ path('app_plant_index') }}" class="hover:underline">Plants</a>
        </div>
    </nav>
    {% endif %}

    {# ----- Container ----- #}
    <div class="{% if bootstrap %}container-fluid{% else %}flex min-h-screen{% endif %}">
        {% if bootstrap %}
        <aside class="col-md-2 bg-light p-3">
            <ul class="nav flex-column">
                <li class="nav-item"><a class="nav-link" href="#">Observations</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Plants</a></li>
            </ul>
        </aside>
        <main class="col-md-10 p-4">
            {% block body %}{% endblock %}
        </main>
        {% endif %}

        {% if tailwind %}
        <aside class="w-1/5 bg-gray-100 p-4 hidden md:block">
            <ul class="space-y-2">
                <li><a href="#" class="hover:underline">Observations</a></li>
                <li><a href="#" class="hover:underline">Plants</a></li>
            </ul>
        </aside>
        <main class="flex-1 p-6">
            {% block body %}{% endblock %}
        </main>
        {% endif %}
    </div>

    {# ----- Footer ----- #}
    {% if bootstrap %}
    <footer class="bg-secondary text-white text-center p-3 mt-4">
        &copy; 2026 MyApp
    </footer>
    {% endif %}

    {% if tailwind %}
    <footer class="bg-gray-300 text-center p-4 mt-auto">
        &copy; 2026 MyApp
    </footer>
    {% endif %}

    {# Flash messages ----- #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="{% if bootstrap %}alert alert-{{ label }} alert-dismissible fade show{% else %}bg-green-200 text-green-800 p-2 rounded mb-2{% endif %}">
                {{ message }}
                {% if bootstrap %}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                {% endif %}
            </div>
        {% endfor %}
    {% endfor %}

</body>
</html>