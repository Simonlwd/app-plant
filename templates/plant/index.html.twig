{% extends 'base.html.twig' %}

{% block title %}
	Plant index
{% endblock %}

{% block body %}
	<h1>Plant index</h1>

	<div>
		<div>
			{% set columns1 = {
        'p.dutchName': 'Dutch',
        'p.latinName': 'Latin',
        'p.createdAt': 'Newest'
    } %}
			{% for field, label in columns1 %}
				{# toggle direction: als dit veld geselecteerd is, draai om, anders ASC #}
				{% set toggledDirection = (sort == field and direction == 'ASC') ? 'DESC' : 'ASC' %}

				<a href="{{ path('app_plant_index', app.request.query.all|merge({'sort': field, 'direction': toggledDirection, 'page': 1})) }}">
					{{ label }}
					{% if sort == field %}
						{% if direction == 'ASC' %}⬆️{% else %}⬇️
						{% endif %}
					{% endif %}
				</a>
			{% endfor %}
		</div>
		<form method="get">
			<input type="text" name="q" value="{{ search }}" placeholder="Search plants...">
			<button type="submit">Search</button>
		</form>

		<div class="sort-links">
			{% set columns = {
        'p.dutchName': 'Dutch',
        'p.latinName': 'Latin',
        'p.createdAt': 'Newest'
    } %}

			{% for field, label in columns %}
				{# toggledDirection: als dit veld geselecteerd is, toggle, anders default ASC #}
				{% set toggledDirection = (sort == field and direction == 'ASC') ? 'DESC' : 'ASC' %}

				<a href="{{ path('app_plant_index', app.request.query.all|merge({ 'sort': field, 'direction': toggledDirection, 'page': 1 })) }}">
					{{ label }}
					{% if sort == field %}
						{% if direction == 'ASC' %}⬆️{% else %}⬇️
						{% endif %}
					{% endif %}
				</a>
			{% endfor %}
		</div>

	</div>
	<table class="table">
		<thead>
			<tr>
				<th>Id</th>
				<th>DutchName
					<a href="{{ path('app_plant_index', app.request.query.all|merge({'sort':'dutch', 'page':1})) }}">
						Dutch
						{% if sort == 'dutch' %}⬆️
						{% endif %}
					</a>
				</th>
				<th>LatinName</th>
				<th>Slug</th>
				<th>Description</th>
				<th>PlantType</th>
				<th>CreatedAt</th>
				<th>UpdatedAt</th>
				<th>actions</th>
			</tr>
		</thead>
		<tbody>
			{% for plant in pagination %}
				<tr>
					<td>{{ plant.id }}</td>
					<td>{{ plant.dutchName }}</td>
					<td>
						<a href="{{ path('app_plant_show_slug', {'slug': plant.slug}) }}">{{ plant.latinName }}</a>
					</td>
					<td>{{ plant.slug }}</td>
					<td>{{ plant.description }}</td>
					<td>{{ plant.plantType }}</td>
					<td>{{ plant.createdAt ? plant.createdAt|date('Y-m-d H:i:s') : '' }}</td>
					<td>{{ plant.updatedAt ? plant.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
					<td>
						<a href="{{ path('app_plant_show', {'id': plant.id}) }}">show</a>
						<a href="{{ path('app_plant_edit', {'id': plant.id}) }}">edit</a>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="9">no records found</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
	{{ knp_pagination_render(pagination) }}
	| aantal :
	{{ pagination.getTotalItemCount }}
	<a href="{{ path('app_plant_new') }}">Create new</a>
{% endblock %}
