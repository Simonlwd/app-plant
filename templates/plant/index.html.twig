{% extends 'base.html.twig' %}

{% block title %}
	Plant index
{% endblock %}

{% block body %}
	<h1>Plant index</h1>

	<table class="table">
		<thead>
			<tr>
				<th>Id</th>
				<th>DutchName</th>
				<th>LatinName</th>
				<th>Slug</th>
				<th>Description</th>
				<th>PlantType</th>
				<th>CreatedAt</th>
				<th>UpdatedAt</th>
				<th>actions</th>
			</tr>
		</thead>
		<tbody>
			{% for plant in pagination %}
				<tr>
					<td>{{ plant.id }}</td>
					<td>{{ plant.dutchName }}</td>
					<td>
						<a href="{{ path('app_plant_show_slug', {'slug': plant.slug}) }}">{{ plant.latinName }}</a>
					</td>
					<td>{{ plant.slug }}</td>
					<td>{{ plant.description }}</td>
					<td>{{ plant.plantType }}</td>
					<td>{{ plant.createdAt ? plant.createdAt|date('Y-m-d H:i:s') : '' }}</td>
					<td>{{ plant.updatedAt ? plant.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
					<td>
						<a href="{{ path('app_plant_show', {'id': plant.id}) }}">show</a>
						<a href="{{ path('app_plant_edit', {'id': plant.id}) }}">edit</a>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="9">no records found</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
	{{ knp_pagination_render(pagination) }}
	<a href="{{ path('app_plant_new') }}">Create new</a>
{% endblock %}
